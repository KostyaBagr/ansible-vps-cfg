VPS_IP=<REMOTE_IP>
VPS_USER=<INITIAL_USER> # usually it is root

# Auth for ansible connection: password | key
VPS_AUTH_METHOD=password
VPS_USER_PASSWORD=<INITIAL_PASSWORD> # required when VPS_AUTH_METHOD=password
# VPS_SSH_PRIVATE_KEY=/path/to/private_key # required when VPS_AUTH_METHOD=key

NEW_USER_NAME=<USERNAME> # e.g. sysadmin
NEW_USER_PASSWORD=<PASSWORD>
NEW_SSH_PORT=<PORT>
